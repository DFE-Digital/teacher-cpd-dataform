config {
    type: "table",
    tags: ["kpi", "tte"],
    assertions: {
        uniqueKey: ["date"]
    },
    bigquery: {
        partitionBy: "date",
        labels: {
            usage: "kpi"
        }
    },
    description: "One row per date, holding the best available count or estimate of live NPD participants and applicants for the registration window that date falls in. Acts as the denominator for a range of NPD KPIs. Those KPIs should apply the baseline across the whole registration window even where the numerator covers a single day, week or month. Mirrors ls_npq_kpi_live_participants_baseline_cube, with one difference: NPD counts distinct users rather than TRNs, because TRN is not captured in the TTE service. Counting users means somebody taking two NPD courses is counted once, which matters from 2027 when Inclusive Teaching and Inclusive Leadership launch alongside Excellence in Reception Teaching. Note that this dedupes within NPD only, so anybody holding both an NPQ and an NPD appears in this cube and in the NPQ cube. Do not add the two baselines together.",
    columns: {
        date: "Date the baseline has been calculated for",
        registration_window_start_date: "First date of the registration window this date falls in",
        registration_window_end_date: "Last date of the registration window this date falls in. NULL where the next window has not been added to the pre_operations block yet",
        registration_window_string: "Registration window formatted for display, for example 2026-27",
        registration_window_year: "Calendar year the registration window starts in, for example 2026 for the 2026-27 window",
        registration_window_day: "How many days into the registration window this date is, counting the start date as day 1",
        registration_window_week: "Week of the registration window this date falls in, treating the start date as day 1 of week 1",
        registration_window_month: "Month of the registration window this date falls in, treating the start date as day 1 of month 1. An integer, so a window starting 25th December 2056 puts 27th December 2056 and 5th January 2057 both in month 1, and 25th January 2057 in month 2",
        academic_year_start_date: "First day of the academic year the registration window feeds into",
        academic_year_end_date: "Last day of that academic year",
        date_is_in_registration_window_to_date_or_past_registration_window: "TRUE where the date sits between the start of the current registration window and today, or inside a window that has already ended. Use this to filter dashboard metrics calculated for the registration window to date",
        date_is_comparable_to_next_registration_window_to_date: "TRUE where the equivalent day in the following registration window has already happened. For example, with consecutive windows of 2nd Feb 2057 to 6th March 2058 and 7th March 2058 to 28th Feb 2059, and today being 8th March 2058, this is TRUE for 2nd and 3rd Feb 2057 and FALSE after that. Use it to compare the window to date against the same period in the previous window. NULL until a second registration window is added",
        number_of_live_tte_participants_and_applicants_baseline_estimate: "Count or estimate of live NPD participants and applicants for the registration window this date falls in, deduplicated by user. Somebody counts as live where the period between their started declaration and their assumed no longer live date overlaps the first academic year starting after the window opens, or where they applied during that academic year regardless of whether they were accepted. Until 1st January of the following calendar year the actual data is too thin to use, so the figure is a forecast of applications plus participants already live at the start of the academic year"
    }
}

WITH
  registration_windows AS (
  SELECT
    DATE(registration_start_date) AS registration_window_start_date,
    LEAD(DATE(registration_start_date)) OVER (ORDER BY registration_start_date ASC) - 1 AS registration_window_end_date,
    EXTRACT(YEAR
    FROM
      registration_start_date) AS registration_window_year,
    ${functions.yearStartDateToAcademicYearString("DATE(registration_start_date)")} AS registration_window_string,
    DATE(EXTRACT(YEAR
      FROM
        registration_start_date), 9, 1) AS academic_year_start_date,
    DATE(EXTRACT(YEAR
      FROM
        registration_start_date) + 1, 8, 31) AS academic_year_end_date
  FROM
    UNNEST(registration_window_start_dates) AS registration_start_date
  WHERE
    DATE(registration_start_date) < CURRENT_DATE ),
  registration_windows_with_metrics AS (
  SELECT
    registration_window_string,
    registration_window_year,
    registration_window_start_date,
    registration_window_end_date,
    academic_year_start_date,
    academic_year_end_date,
    /* Count users rather than applications, so somebody taking two NPD courses is counted once. */
    COUNT(DISTINCT
    IF
      (
      /* Count users who started an NPD before the end of the academic year this window's applications are for */
      ( DATE(started_declaration_date) <= registration_windows.academic_year_end_date
      /* ...and who cannot be assumed to have stopped before that academic year began... */
          AND ( assumed_no_longer_live_date >= registration_windows.academic_year_start_date
            OR assumed_no_longer_live_date IS NULL ) )
            /* ...plus users who applied within that academic year, accepted or not */
        OR ( DATE(application_created_at) BETWEEN registration_windows.academic_year_start_date
          AND registration_windows.academic_year_end_date ), user_id, NULL)) AS number_of_live_tte_participants_and_applicants_in_registration_window_ay,
    /* Count users already live on the first day of the academic year.
    Only used in the forecast branch for the current registration window, below. */
    COUNT(DISTINCT
    IF
      ( DATE(started_declaration_date) < registration_windows.academic_year_start_date
        AND ( assumed_no_longer_live_date >= registration_windows.academic_year_start_date
          OR assumed_no_longer_live_date IS NULL ), user_id, NULL)) AS number_of_live_tte_participants_at_start_of_registration_window_ay
  FROM
    ${ref(`tte_participants`)},
    registration_windows
  GROUP BY
    ALL ),
  dates_with_metrics AS (
  SELECT
    date,
    DATE_DIFF(date, registration_window_start_date, DAY) + 1 AS registration_window_day,
    DATE_DIFF(date, registration_window_start_date, WEEK) + 1 AS registration_window_week,
    DATE_DIFF(date, registration_window_start_date, MONTH) + 1 AS registration_window_month,
    registration_window_string,
    registration_window_year,
    registration_window_start_date,
    registration_window_end_date,
    academic_year_start_date,
    academic_year_end_date,
    CASE
      WHEN (CURRENT_DATE BETWEEN registration_window_start_date AND registration_window_end_date) OR (registration_window_end_date IS NULL AND CURRENT_DATE >= registration_window_start_date) THEN date < CURRENT_DATE
      WHEN CURRENT_DATE > registration_window_end_date THEN TRUE
      ELSE FALSE
  END
    AS date_is_in_registration_window_to_date_or_past_registration_window,
    CASE
      WHEN
      /* When date is in the current registration window */
      (CURRENT_DATE BETWEEN registration_window_start_date AND registration_window_end_date OR ( CURRENT_DATE >= registration_window_start_date AND registration_window_end_date IS NULL ) )
      /* And when it's not yet 1st January in the calendar year after the registration window started */
      AND CURRENT_DATE < DATE(registration_window_year + 1, 1, 1) THEN forecast_tte_applications_in_current_registration_window + number_of_live_tte_participants_at_start_of_registration_window_ay
      ELSE number_of_live_tte_participants_and_applicants_in_registration_window_ay
  END
    AS number_of_live_tte_participants_and_applicants_baseline_estimate
  FROM
    UNNEST(GENERATE_DATE_ARRAY((
        SELECT
          MIN(registration_window_start_date)
        FROM
          registration_windows), CURRENT_DATE - 1)) AS date
  LEFT JOIN
    registration_windows_with_metrics
  ON
    ((date BETWEEN registration_window_start_date
        AND registration_window_end_date)
      OR (date >= registration_window_start_date
        AND registration_window_end_date IS NULL)) )
SELECT
  *,
  LEAD(date_is_in_registration_window_to_date_or_past_registration_window) OVER (PARTITION BY registration_window_day ORDER BY registration_window_year ASC) AS date_is_comparable_to_next_registration_window_to_date
FROM
  dates_with_metrics

pre_operations {
  /* Forecast number of NPD applications in the current registration window. Used before 1st January to estimate the baseline while actual data is still coming in.
    PROVISIONAL: this figure was carried over from the NPQ cube and has not been set for NPD. Only 2,246 applications exist so far. Replace it with proper forecast when there is one available. */
  DECLARE
    forecast_tte_applications_in_current_registration_window INT64 DEFAULT 20000;
    /* The registration window the forecast above applies to. Powers the assertion below. Update both together. */
  DECLARE
    registration_window_start_date_forecast_last_set_for DATE DEFAULT "2026-09-01";
    /* Start dates of NPD registration windows. For a new window this is the day applications first open for the coming academic year. */
  DECLARE
    registration_window_start_dates ARRAY<DATE> DEFAULT [ DATE("2026-06-23") ];
}

post_operations {
  ASSERT
    (
    SELECT
      DATE_DIFF(CURRENT_DATE, MAX(registration_window_start_date), DAY) < 360
    FROM
      UNNEST(registration_window_start_dates) AS registration_window_start_date ) AS "Latest registration window is more than 360 days ago. Please add this to registration_window_start_dates variable in ls_tte_kpi_live_participants_baseline_cube.sqlx pre_operations block.";
  ASSERT
    (
    SELECT
      DATE_DIFF(CURRENT_DATE, registration_window_start_date_forecast_last_set_for, DAY) < 360 ) AS "Forecast number of NPD applications for latest registration window was set more than 360 days ago. Please update forecast_npd_applications_in_current_registration_window and registration_window_start_date_forecast_last_set_for variables in ls_tte_kpi_live_participants_baseline_cube.sqlx pre_operations block."
}
