-- PART 2: find any teachers who are registered on RIAB with an open_induction period where this was created in the time bounds
-- and not in RECT
riab_open_induction_periods AS (
  SELECT
    trn,
    appropriate_body_period_id,
    appropriate_body_name,
    started_on,
    finished_on,
    DATE(induction_period_created_at) AS induction_period_created_at
  FROM ${ref('ecf2_teacher_induction_periods')}
  WHERE
    -- NOTE: for future registration windows, this date should be updated 
    -- with the first opportunity to create induction windows in the registration window
    DATE(induction_period_created_at) >= EARLIEST_TRAINING_REG_DATE
    AND finished_on IS NULL
  QUALIFY
    ROW_NUMBER() OVER (PARTITION BY trn ORDER BY induction_period_created_at DESC ) = 1
),

-- Final query for teachers registered in RIAB but have no training period in RECT
riab_not_rect AS (
  SELECT 
    riab.trn,
    riab.appropriate_body_period_id AS appropriate_body_id,
    riab.appropriate_body_name AS appropriate_body,
    ab_regions.hub_region AS ab_hub_region,
    induction_period_created_at,
    CASE 
      WHEN rect.trn IS NOT NULL THEN TRUE
      ELSE FALSE
    END AS in_rect

  FROM riab_open_induction_periods riab
  LEFT JOIN ${ref('ecf2_training_periods_latest')} rect
    ON riab.trn = rect.trn
    AND rect.participant_type = 'ect'
    AND rect.training_status != 'withdrawn'
    AND DATE(rect.created_at) >= EARLIEST_TRAINING_REG_DATE

  LEFT JOIN ab_mapping
    ON riab.appropriate_body_period_id = SAFE_CAST(ab_mapping.rect_id AS String)

  LEFT JOIN ${ref('ab_to_hub_region_mapping_2025_09_15')} AS ab_regions
    ON ab_mapping.ecf_id = ab_regions.appropriate_body_id

)

SELECT * FROM riab_not_rect

