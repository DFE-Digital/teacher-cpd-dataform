config {
    type: "table",
    tags: ["ecf2"],
    assertions: {
        uniqueKey: ["trn"],
    },
    description: "This mart identifies ECTs that are registered in RIAB but not in RECT. This is an annual report run in October",
    columns: {
        trn: {
            description: "TRN associated with the ECT's profile.",
            bigqueryPolicyTags: ["projects/ecf-bq/locations/europe-west2/taxonomies/6302091323314055162/policyTags/301313311867345339"]
        },
        appropriate_body_id: 'The id of the Appropriate Body as reported by the school of the ECTs first training period.',
        ab_hub_region: 'The Hub Region code for the Appropriate Body dervied from a manual mapping table',
        induction_period_created_at: "The created_at date of the RIAB induction record",
        in_rect: "True/False if the ECT has a training period in RECT",
    }
}



pre_operations {
  DECLARE CURRENT_YEAR INT64 DEFAULT 2026;
  DECLARE EARLIEST_TRAINING_REG_DATE DATE DEFAULT DATE '2026-06-15';
}


